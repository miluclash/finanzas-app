{
  "name": "finanzas-app",
  "productName": "Finanzas",
  "version": "0.5.0",
  "description": "App de escritorio de finanzas personales (uso local, un solo usuario)",
  "main": "./out/main/index.js",
  "author": "Michael",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/build-mcp.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "golden:update": "node scripts/golden-update.mjs",
    "golden:capture": "node scripts/golden-capture.mjs",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "mcp": "node scripts/build-mcp.mjs && node out/mcp/server.cjs",
    "maquetas": "vite --config design/maquetas/vite.config.ts",
    "maquetas:capturas": "node scripts/maquetas-capturas.mjs"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "sql.js": "^1.14.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  }
}
